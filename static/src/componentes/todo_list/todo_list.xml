<templates>
    <t t-name="owl_dev_todo_template">
        <div class="todo-list-container">
            <div class="row mx-2 mt-3">
                <div class="col-lg-6">
                    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#exampleModal"
                            t-on-click="addTask"> New </button>
                </div>
            <div class="col-lg-6">
            <div class="input-group">
                <input type="text" class="form-control" placeholder="Search here....."
                t-ref="search-input" t-on-keyup="searchTask"/>
                <button class="btn btn-outline-primary">Search</button>
            </div>
            </div>
        </div>
        <div class="row m-2">
            <div class="col">
                <table class="table table-striped table-hover border">
                    <thead>
                        <tr>
                            <th scope="col">Task DES</th>
                            <th scope="col">Complete</th>
                            <th scope="col"> </th>
                        </tr>
                    </thead>
                    <tbody t-foreach="state.task_list" t-as="task" t-key="task.id">
                        <tr>
                            <th>
                                <div class="form-check">
                            <input class="form-check-input" type="checkbox" t-att-id="task.id"
                                   t-att-checked="task.complete" t-on-click="(e)=>this.uncheck(e,task)" />
                            <label class="form-check-label" t-att-for="task.id"
                                    t-attf-class="#{task.complete and 'text-decoration-line-through'}"> <span t-esc="task.name"></span> </label>
                            </div>
                            </th>
                            <th>
                            <input type="color" class="form-control form-control-color" id="myColorInput" t-att-value="task.color" title="Pick color"
                            t-on-change="(e)=>this.updateColor(e,task)"/>
                            </th>
                            <th>
                            <button class="btn btn-success me-2" data-bs-toggle="modal" data-bs-target="#exampleModal"
                               t-on-click="()=>this.editTask(task)" > Edit </button>
                            <button class="btn btn-danger" t-on-click="()=>this.deleteTask(task)">Delete</button>
                            </th>
                            </tr>
    </tbody>
    </table>
    </div>
    </div>
    </div>
    <!--  Modal  -->
    <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
    <div class="modal-content">
    <div class="modal-header">
    <h1 class="modal-title fs-5" id="exampleModalLabel">Modal title</h1>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"/>
    </div>
    <div class="modal-body">
    <div class="row mb-3">
    <label for="name" class="col-sm-2 col-form-label" >Task DES</label>
    <div class="col-sm-10">
    <input type="text" class="form-control" t-model="state.task.name" t-att-value="state.task.name" id="name"/>
    </div>
    </div>
    <div class="row mb-3">
    <label for="name" class="col-sm-2 col-form-label">Color</label>
    <div class="col-sm-10">
    <input type="color" class="form-control form-control-color" id="color" t-model="state.task.color" t-att-value="state.task.color" 
       title="Pick color"/>
    </div>
    </div>
    <div class="row mb-3">
    <label for="complete" class="col-sm-2 col-form-label">Complete</label>
    <div class="col-sm-10">
    <input class="form-check-input" type="checkbox" id="complete"
                t-model="state.task.complete" t-att-checked="state.task.complete" />
    </div>
    </div>
    </div>
    <div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
    <button type="button" class="btn btn-primary" t-on-click="saveTask">Save</button>
    </div>
    </div>
    </div>
    </div>
    </t>
</templates>