<odoo>
  <data>
    
    <record id="owl_dev.todo_view_tree" model="ir.ui.view">
      <field name="name">todo_list_tree_view</field>
      <field name="model">owl_dev_todo_list</field>
      <field name="arch" type="xml">
        <tree>
          <field name="name"></field>
          <field name="color"></field>
          <field name="complete"></field>
        </tree>
      </field>
    </record>

    <record id="owl_dev.todo_view_form" model="ir.ui.view">
      <field name="name">todo_list_form_view</field>
      <field name="model">owl_dev_todo_list</field>
      <field name="arch" type="xml">
            <form string="">
              <sheet>
                <group>
                  <field name="name"></field>
                  <field name="color"></field>
                  <field name="complete"></field>
                  
                </group>
              </sheet>
            </form>
          </field>
        </record>





    <record id="owl_dev.todo_list_action" model="ir.actions.act_window">
      <field name="name">owl_dev_todo_list_action</field>
      <field name="res_model">owl_dev_todo_list</field>
      <field name="view_mode">tree,form</field>
    </record>


    <record id="owl_dev.todo_list_action_js_view" model="ir.actions.client">
      <field name="name">Todo List OWL</field>
      <field name="tag">owl_dev.todo_list_action_js</field>
    </record>


    <menuitem
      id="owl_dev_menu"
      name="Owl Dev"
      sequence="1">

       <menuitem
        id="to_do_list_menu"
        name="Todo List"
        sequence="10"
        action="owl_dev.todo_list_action"/>
        <menuitem 
        id="owl_todo_list"
        name="Todo List OWL"
        sequence="20"
        action="owl_dev.todo_list_action_js_view"/>
        
    </menuitem>
  </data>
</odoo>
